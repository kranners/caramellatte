---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const posts = await getCollection("posts");
---

<Base title="caramellatte">
  <h1>Posts</h1>
  <ul class="posts">
    {posts.map((post) => (
      <li>
        <a href={`/posts/${post.id}`}>{post.data.title}</a>
      </li>
    ))}
  </ul>
</Base>
